-- ฟังก์ชันสร้างปุ่ม Toggle
local function CreateToggle(text, callback)
    local Button = Instance.new("TextButton")
    Button.Parent = Container
    Button.Size = UDim2.new(1, 0, 0, 40)
    Button.BackgroundColor3 = Color3.fromRGB(12, 35, 18)
    Button.BorderColor3 = Color3.fromRGB(30, 100, 45)
    Button.Font = Enum.Font.SourceSansBold
    Button.Text = text .. " : [ปิด]"
    Button.TextColor3 = Color3.fromRGB(200, 200, 200)
    Button.TextSize = 14

    local state = false
    Button.MouseButton1Click:Connect(function()
        state = not state
        if state then
            Button.Text = text .. " : [เปิด]"
            Button.BackgroundColor3 = Color3.fromRGB(25, 90, 40)
            Button.TextColor3 = Color3.fromRGB(100, 255, 150)
        else
            Button.Text = text .. " : [ปิด]"
            Button.BackgroundColor3 = Color3.fromRGB(12, 35, 18)
            Button.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
        callback(state)
    end)
end

-- ============================================
-- ระบบฟังก์ชันหลัก
-- ============================================

-- 1. No Cooldown & Energy Booster
CreateToggle("1. ไร้คูลดาวน์ / พลังงานไม่จำกัด", function(state)
    Config.NoCooldown = state
end)

RunService.RenderStepped:Connect(function()
    if Config.NoCooldown and LocalPlayer.Character then
        -- ปรับค่าใน Tool / Skill
        for _, item in pairs(LocalPlayer.Character:GetChildren()) do
            if item:IsA("Tool") then
                if item:FindFirstChild("Cooldown") then
                    item.Cooldown.Value = 0
                end
                if item:FindFirstChild("EnergyCost") then
                    item.EnergyCost.Value = 0
                end
            end
        end
        -- ค้นหาโฟลเดอร์พลังงานในตัวละคร
        local stats = LocalPlayer.Character:FindFirstChild("Stats") or LocalPlayer.Character:FindFirstChild("Energy")
        if stats then
            for _, val in pairs(stats:GetChildren()) do
                if val:IsA("NumberValue") or val:IsA("IntValue") then
                    if string.find(string.lower(val.Name), "energy") or string.find(string.lower(val.Name), "stamina") then
                        val.Value = 9999
                    end
                end
            end
        end
    end
end)

-- 2. FPS Booster / Potato Graphics (ภาพมันฝรั่งลดแลค)
CreateToggle("2. ภาพมันฝรั่ง (FPS Booster)", function(state)
    Config.PotatoGraphics = state
    if state then
        -- ลดระดับเอฟเฟกต์แสงและเงา
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.Brightness = 1
        
        if sethiddenproperty then
            sethiddenproperty(Lighting, "Technology", Enum.Technology.Compatibility)
        end
        
        -- ปรับกราฟิกต่ำสุด
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01

        -- ลบ Texture และเอฟเฟกต์
        for _, obj in pairs(game:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.Material = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj:Destroy()
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                obj.Enabled = false
            elseif obj:IsA("PostEffect") then
                obj.Enabled = false
            end
        end
    end
end)
